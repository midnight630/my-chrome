{
  "private": true,
  "name": "识趣图片",
  "description": "识别社交媒体里，目前支持电脑网页直登的 抖音/小红书评论区里的无水印图片",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "Your Name",
    "email": "your@email.com",
    "url": "https://yourwebsite.com"
  },
  "scripts": {
    "dev": "extension dev --chromium-binary \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --port 3100 --no-browser",
    "dev:auto": "extension dev --browser chrome --port 3100 --profile ./dist/extension-profile-chrome --allow-control --logs info --log-context all",
    "dev:system": "extension dev --chromium-binary \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --port 3100 --profile ./dist/extension-profile-chromium --allow-control --logs info --log-context all",
    "dev:no-browser": "extension dev --chromium-binary \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --port 3100 --no-browser",
    "dev:install-browser": "extension install chrome",
    "reload": "extension reload --browser chromium",
    "reload:auto": "extension reload --browser chrome",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge"
  },
  "dependencies": {},
  "devDependencies": {
    "extension": "^4.0.14"
  },
  "packageManager": "npm@10.9.8",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "less"
    ]
  }
}
